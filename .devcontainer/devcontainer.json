{
  // Codespaces: افتح الريبو من GitHub › Code › Codespaces وكل حاجة بتتجهز لوحدها
  // (حساب الطلاب فيه ساعات Codespaces مجانية كل شهر)
  "name": "Qassimz",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "npm ci",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": { "label": "Qassimz (vite dev)", "onAutoForward": "openPreview" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["esbenp.prettier-vscode", "bradlc.vscode-tailwindcss", "GitHub.copilot", "GitHub.copilot-chat"],
      "settings": { "editor.formatOnSave": true, "editor.defaultFormatter": "esbenp.prettier-vscode" }
    }
  }
}
